-- busted configuration. Runs specs under tests/lua and puts mdview's Lua
-- sources on the module path so specs can `require("mdview....")`. Only
-- pure-Lua modules (no `vim` global) are exercised here; anything that needs
-- the Neovim API belongs in a headless-nvim test, not plain busted.
--
-- Some mdview modules delegate to lib.nvim's pure-Lua helpers (require("lib.
-- lua....")), so lib.nvim's own lua/ tree must be on the path too. Mirrors
-- tests/nvim/run.lua's add_lib_nvim(): a sibling checkout (../lib.nvim) wins
-- if present, with .deps/lib.nvim as the CI-cloned fallback — an unresolved
-- pattern is simply skipped by Lua's module loader, so listing both is safe
-- regardless of which one a given machine actually has.
return {
	default = {
		verbose = true,
		lpath = "./lua/?.lua;./lua/?/init.lua;"
			.. "../lib.nvim/lua/?.lua;../lib.nvim/lua/?/init.lua;"
			.. ".deps/lib.nvim/lua/?.lua;.deps/lib.nvim/lua/?/init.lua",
		pattern = "_spec",
	},
}
